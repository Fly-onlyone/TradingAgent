<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:SpikeAvalonia"
        x:Class="SpikeAvalonia.MainWindow"
        Title="Spike - Avalonia"
        Width="1400" Height="900"
        Background="#211b14"
        FontSize="14"
        Foreground="#F8FAFC">
	<Grid RowDefinitions="56,*">

		<!-- Header bar: 48 px panel -->
		<Border Grid.Row="0" Margin="8,8,8,0" Height="48"
		        Background="#B8342818"
		        BorderBrush="#14F97316" BorderThickness="1" CornerRadius="12">
			<Grid ColumnDefinitions="*,Auto">
				<TextBlock Grid.Column="0" Text="Trading Agent - UI spike" FontSize="16" FontWeight="SemiBold"
				           VerticalAlignment="Center" Margin="16,0,0,0" />
				<Button x:Name="PauseButton" Grid.Column="1" Classes="pause" Content="Pause"
				        VerticalAlignment="Center" Margin="0,0,10,0" Click="OnPauseClick" />
			</Grid>
		</Border>

		<Grid Grid.Row="1" Margin="8" ColumnDefinitions="420,*">

			<!-- Chat pane -->
			<Border Grid.Column="0" Margin="0,0,8,0" Background="#332818" BorderBrush="#14F97316"
			        BorderThickness="1" CornerRadius="12" ClipToBounds="True">
				<ScrollViewer x:Name="ChatScroll" HorizontalScrollBarVisibility="Disabled">
					<ItemsControl x:Name="ChatList" Margin="10">
						<ItemsControl.ItemTemplate>
							<DataTemplate x:DataType="local:ChatMessage">
								<Border Background="#211b14" BorderBrush="#26F97316" BorderThickness="1"
								        CornerRadius="12" Padding="12" Margin="0,0,0,8">
									<local:MarkdownView Text="{Binding Text}" />
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</ScrollViewer>
			</Border>

			<Grid Grid.Column="1" RowDefinitions="*,280">

				<!-- Chart -->
				<Border Grid.Row="0" Margin="0,0,0,8" Background="#332818" BorderBrush="#14F97316"
				        BorderThickness="1" CornerRadius="12" ClipToBounds="True">
					<local:CandleChart x:Name="Chart" />
				</Border>

				<!-- Orders table -->
				<Border Grid.Row="1" Background="#332818" BorderBrush="#14F97316"
				        BorderThickness="1" CornerRadius="12" ClipToBounds="True">
					<Grid RowDefinitions="30,*">
						<Border Grid.Row="0" BorderBrush="#26F97316" BorderThickness="0,0,0,1">
							<Grid ColumnDefinitions="*,150,100,50,70,90,90,90,70" Margin="10,0">
								<Grid.Styles>
									<Style Selector="TextBlock">
										<Setter Property="Foreground" Value="#B8A894" />
										<Setter Property="FontWeight" Value="SemiBold" />
										<Setter Property="VerticalAlignment" Value="Center" />
									</Style>
								</Grid.Styles>
								<TextBlock Grid.Column="0" Text="id" />
								<TextBlock Grid.Column="1" Text="time (UTC)" />
								<TextBlock Grid.Column="2" Text="symbol" />
								<TextBlock Grid.Column="3" Text="side" />
								<TextBlock Grid.Column="4" Text="type" />
								<TextBlock Grid.Column="5" Text="price" TextAlignment="Right" Margin="0,0,10,0" />
								<TextBlock Grid.Column="6" Text="size" TextAlignment="Right" Margin="0,0,10,0" />
								<TextBlock Grid.Column="7" Text="filled" TextAlignment="Right" Margin="0,0,10,0" />
								<TextBlock Grid.Column="8" Text="status" />
							</Grid>
						</Border>
						<ListBox x:Name="OrdersList" Grid.Row="1" Background="Transparent" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
							<ListBox.Styles>
								<Style Selector="ListBoxItem">
									<Setter Property="Padding" Value="0" />
									<Setter Property="MinHeight" Value="26" />
								</Style>
							</ListBox.Styles>
							<ListBox.ItemTemplate>
								<DataTemplate x:DataType="local:OrderRow">
									<Grid ColumnDefinitions="*,150,100,50,70,90,90,90,70" Height="26" Margin="10,0">
										<TextBlock Grid.Column="0" Text="{Binding Id}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
										<TextBlock Grid.Column="1" Text="{Binding TimeText}" VerticalAlignment="Center" />
										<TextBlock Grid.Column="2" Text="{Binding Symbol}" VerticalAlignment="Center" />
										<TextBlock Grid.Column="3" Text="{Binding Side}" Foreground="{Binding SideBrush}" VerticalAlignment="Center" />
										<TextBlock Grid.Column="4" Text="{Binding Type}" VerticalAlignment="Center" />
										<TextBlock Grid.Column="5" Text="{Binding PriceText}" TextAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center" />
										<TextBlock Grid.Column="6" Text="{Binding SizeText}" TextAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center" />
										<TextBlock Grid.Column="7" Text="{Binding FilledText}" TextAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center" />
										<TextBlock Grid.Column="8" Text="{Binding Status}" VerticalAlignment="Center" />
									</Grid>
								</DataTemplate>
							</ListBox.ItemTemplate>
						</ListBox>
					</Grid>
				</Border>
			</Grid>
		</Grid>
	</Grid>
</Window>
