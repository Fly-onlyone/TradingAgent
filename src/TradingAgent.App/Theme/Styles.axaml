<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{StaticResource PanelBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource PanelCornerRadius}" />
  </Style>

  <Style Selector="Border.header">
    <Setter Property="Background" Value="{StaticResource HeaderPanelBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource PanelCornerRadius}" />
  </Style>

  <Style Selector="ListBox.navigation ListBoxItem">
    <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
    <Setter Property="Margin" Value="0,0,0,2" />
  </Style>

  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="TextBlock.pageTitle">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="TextBlock.secondary">
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
  </Style>

  <Style Selector=":is(TextBlock).good">
    <Setter Property="Foreground" Value="{StaticResource BullishBrush}" />
  </Style>

  <Style Selector=":is(TextBlock).bad">
    <Setter Property="Foreground" Value="{StaticResource BearishBrush}" />
  </Style>

  <Style Selector="SelectableTextBlock.value">
    <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,monospace" />
  </Style>

</Styles>
