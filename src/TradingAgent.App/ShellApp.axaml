<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="using:TradingAgent.App"
             x:Class="TradingAgent.App.ShellApp"
             RequestedThemeVariant="Dark">

  <Application.DataTemplates>
    <app:ViewLocator />
  </Application.DataTemplates>

  <!--
    The colours, shadows and corner radii are not here: ThemeBuilder works them out from the chosen
    preset and ShellApp.ApplyTheme merges them in. Every reference to them is a DynamicResource.
  -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <MergeResourceInclude Source="/Theme/Tokens/Typography.axaml" />
        <MergeResourceInclude Source="/Theme/Tokens/Motion.axaml" />
        <MergeResourceInclude Source="/Theme/Tokens/Icons.axaml" />
        <MergeResourceInclude Source="/Theme/Kit.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <!-- The base for controls the kit has no theme for. Its palette follows the preset (ShellApp.ApplyTheme). -->
    <FluentTheme />
    <StyleInclude Source="/Theme/Styles.axaml" />
  </Application.Styles>

</Application>
