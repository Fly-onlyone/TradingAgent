<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="using:TradingAgent.App"
             x:Class="TradingAgent.App.ShellApp"
             RequestedThemeVariant="Dark">

  <Application.DataTemplates>
    <app:ViewLocator />
  </Application.DataTemplates>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <MergeResourceInclude Source="/Theme/Palette.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <!-- "Solar" preset of the previous UI. Only the dark variant exists. -->
        <ColorPaletteResources x:Key="Dark"
                               Accent="#F97316"
                               RegionColor="#211B14"
                               ErrorText="#EF4444" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="/Theme/Styles.axaml" />
  </Application.Styles>

</Application>
