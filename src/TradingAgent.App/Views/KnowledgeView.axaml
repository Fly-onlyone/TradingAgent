<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TradingAgent.App.ViewModels"
             xmlns:knowledge="using:TradingAgent.Data.Knowledge"
             xmlns:c="using:TradingAgent.App.Controls"
             xmlns:m="using:TradingAgent.App.Motion"
             x:Class="TradingAgent.App.Views.KnowledgeView"
             x:DataType="vm:KnowledgeViewModel">

  <Grid RowDefinitions="Auto,*">
    <c:SectionHeader Title="Knowledge" Subtitle="One search over strategies, trade lessons, patterns, news and memories" />

    <Grid Grid.Row="1" ColumnDefinitions="*,380" ColumnSpacing="24">

      <c:Card Padding="16" m:Enter.Kind="Reveal">
        <Grid RowDefinitions="Auto,Auto,*">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox Classes="small" x:Name="QueryBox" Text="{Binding Query}"
                     PlaceholderText="Search strategies, trade lessons, patterns, news and memories"
                     AutomationProperties.Name="Search knowledge" />
            <Button Grid.Column="1" Classes="contained" IsDefault="True" AutomationProperties.Name="Search" Command="{Binding SearchCommand}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Width="20" Height="20" Margin="-4,0,0,0" Data="{StaticResource IconSearch}" />
                <TextBlock Text="Search" />
              </StackPanel>
            </Button>
          </Grid>
          <TextBlock Grid.Row="1" Classes="caption secondary" Margin="0,8" Text="{Binding ResultLine}" />
          <Panel Grid.Row="2">
            <ListBox Classes="table" AutomationProperties.Name="Results" ItemsSource="{Binding Results}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     IsVisible="{Binding !!Results.Count}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="knowledge:KnowledgeHit">
                  <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <c:Chip Classes="outlined small primary" Content="{Binding Label}" />
                      <TextBlock Classes="body2 semibold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Title}" />
                    </StackPanel>
                    <TextBlock Classes="body2 secondary" TextWrapping="Wrap" MaxLines="5" TextTrimming="CharacterEllipsis" Text="{Binding Body}" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <c:EmptyState IsVisible="{Binding !Results.Count}"
                          Icon="{StaticResource IconSearch}"
                          Title="Nothing to show"
                          Description="Type what you are looking for and press Search." />
          </Panel>
        </Grid>
      </c:Card>

      <c:Card Grid.Column="1" Padding="16,16,16,24" VerticalAlignment="Top" m:Enter.Kind="Reveal" m:Enter.Delay="0.1">
        <StackPanel Spacing="16">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <PathIcon VerticalAlignment="Center" Foreground="{DynamicResource PrimaryBrush}" Data="{StaticResource IconPsychology}" />
            <TextBlock Classes="h6" Text="Search by meaning" />
          </StackPanel>
          <TextBlock Classes="body2 secondary" TextWrapping="Wrap"
                     Text="With an embedding provider the search also finds texts that mean the same in other words. Without one it finds by words." />
          <ComboBox HorizontalAlignment="Stretch" c:Field.Label="Provider" ItemsSource="{Binding Providers}" SelectedItem="{Binding Provider}"
                    AutomationProperties.Name="Embedding provider" />
          <TextBlock Classes="caption secondary" TextWrapping="Wrap" Text="{Binding Hint}" />
          <TextBox c:Field.Label="Address (optional)" Text="{Binding BaseUrl}" PlaceholderText="The provider's usual address"
                   AutomationProperties.Name="Embedding address" />
          <TextBox c:Field.Label="Model (optional)" Text="{Binding Model}" PlaceholderText="The provider's usual model"
                   AutomationProperties.Name="Embedding model" />
          <Button Classes="outlined" HorizontalAlignment="Left" Content="Embed now" Command="{Binding IndexNowCommand}" />
          <SelectableTextBlock Classes="caption secondary" TextWrapping="Wrap" Text="{Binding Status}" />
        </StackPanel>
      </c:Card>
    </Grid>
  </Grid>
</UserControl>
