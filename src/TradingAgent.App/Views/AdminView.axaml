<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TradingAgent.App.ViewModels"
             xmlns:admin="using:TradingAgent.Data.Admin"
             xmlns:c="using:TradingAgent.App.Controls"
             xmlns:m="using:TradingAgent.App.Motion"
             x:Class="TradingAgent.App.Views.AdminView"
             x:DataType="vm:AdminViewModel">

  <UserControl.Styles>
    <!-- Text that is read letter by letter: a file name, a log entry. -->
    <Style Selector="Border.code">
      <Setter Property="Padding" Value="12" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusBase}" />
      <Setter Property="Background" Value="{DynamicResource ActionHoverBrush}" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*">
    <c:SectionHeader Title="Admin" Subtitle="The log, the database file, backups, and deleting data" />

    <c:Card Grid.Row="1" m:Enter.Kind="Reveal">
      <TabControl Classes="divided" Padding="16">

        <TabItem Header="Log">
          <Grid RowDefinitions="Auto,Auto,*,Auto">
            <Grid ColumnDefinitions="180,*,Auto" ColumnSpacing="8">
              <ComboBox Classes="small" HorizontalAlignment="Stretch" c:Field.Label="Level" ItemsSource="{Binding LogLevels}"
                        SelectedItem="{Binding LogLevel}" AutomationProperties.Name="Log level" />
              <TextBox Classes="small" Grid.Column="1" Text="{Binding LogQuery}" PlaceholderText="Text in the entry"
                       AutomationProperties.Name="Search the log" />
              <Button Classes="outlined" Grid.Column="2" Content="Refresh" Command="{Binding RefreshLogsCommand}" />
            </Grid>
            <Border Grid.Row="1" Classes="tableHead small" Margin="0,12,0,0">
              <Grid ColumnDefinitions="150,90,220,*" ColumnSpacing="12" Margin="0,0,8,0">
                <TextBlock Text="When" />
                <TextBlock Grid.Column="1" Text="Level" />
                <TextBlock Grid.Column="2" Text="Source" />
                <TextBlock Grid.Column="3" Text="Message" />
              </Grid>
            </Border>
            <ListBox Grid.Row="2" Classes="table small" AutomationProperties.Name="Log entries"
                     ItemsSource="{Binding Logs}" SelectedItem="{Binding SelectedLog}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:LogItemViewModel">
                  <Grid ColumnDefinitions="150,90,220,*" ColumnSpacing="12">
                    <TextBlock Classes="secondary" Text="{Binding When}" />
                    <TextBlock Grid.Column="1" Classes="medium" Text="{Binding Level}" Classes.bad="{Binding IsError}" />
                    <TextBlock Grid.Column="2" Classes="secondary" Text="{Binding Logger}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="3" Text="{Binding Message}" TextTrimming="CharacterEllipsis" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <Border Grid.Row="3" Classes="code" Margin="0,12,0,0"
                    IsVisible="{Binding LogDetail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
              <ScrollViewer MaxHeight="180">
                <SelectableTextBlock Classes="mono" FontSize="12" TextWrapping="Wrap" Text="{Binding LogDetail}" />
              </ScrollViewer>
            </Border>
          </Grid>
        </TabItem>

        <TabItem Header="Database">
          <Grid RowDefinitions="Auto,Auto,Auto,*">
            <Border Classes="code">
              <SelectableTextBlock Classes="mono" FontSize="13" TextWrapping="Wrap" Text="{Binding DatabaseInfo}" />
            </Border>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,12">
              <Button Classes="outlined" Content="Check the file" Command="{Binding CheckIntegrityCommand}" />
              <Button Classes="outlined" Content="Compact" Command="{Binding CompactCommand}" />
              <TextBlock Classes="body2" VerticalAlignment="Center" Margin="8,0,0,0" Text="{Binding DatabaseStatus}" />
            </StackPanel>
            <Border Grid.Row="2" Classes="tableHead small">
              <Grid ColumnDefinitions="320,*" ColumnSpacing="12">
                <TextBlock Text="Table" />
                <TextBlock Grid.Column="1" Text="Rows" />
              </Grid>
            </Border>
            <ListBox Grid.Row="3" Classes="table small" AutomationProperties.Name="Tables" ItemsSource="{Binding Tables}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="admin:TableInfo">
                  <Grid ColumnDefinitions="320,*" ColumnSpacing="12">
                    <TextBlock Classes="mono" FontSize="13" Text="{Binding Name}" />
                    <TextBlock Grid.Column="1" Text="{Binding Rows}" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </TabItem>

        <TabItem Header="Backup">
          <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
            <TextBlock Classes="body2 secondary" TextWrapping="Wrap"
                       Text="A backup is a copy of the whole database: chats, tasks, strategies, settings, and your keys, which stay encrypted for your Windows account. A backup can be restored on this Windows account only." />
            <WrapPanel Grid.Row="1" Margin="0,12,0,4">
              <Button Classes="contained" Margin="0,0,8,8" AutomationProperties.Name="Back up now" Command="{Binding BackUpCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <PathIcon Width="20" Height="20" Margin="-4,0,0,0" Data="{StaticResource IconBackup}" />
                  <TextBlock Text="Back up now" />
                </StackPanel>
              </Button>
              <Button Classes="outlined warning" Margin="0,0,8,8" Content="Restore the chosen backup…" Command="{Binding AskRestoreCommand}" />
              <Button Classes="outlined error" Margin="0,0,8,8" Content="Delete the chosen backup" Command="{Binding DeleteBackupCommand}" />
              <Button Classes="outlined inherit" Margin="0,0,0,8" Content="Call off the restore" Command="{Binding CancelRestoreCommand}" />
            </WrapPanel>
            <Border Grid.Row="2" Classes="tableHead small">
              <Grid ColumnDefinitions="380,*" ColumnSpacing="12" Margin="0,0,8,0">
                <TextBlock Text="Backup" />
                <TextBlock Grid.Column="1" Text="Made" />
              </Grid>
            </Border>
            <ListBox Grid.Row="3" Classes="table small" AutomationProperties.Name="Backups"
                     ItemsSource="{Binding Backups}" SelectedItem="{Binding SelectedBackup}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:BackupItemViewModel">
                  <Grid ColumnDefinitions="380,*" ColumnSpacing="12">
                    <TextBlock Classes="mono" FontSize="13" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                    <TextBlock Grid.Column="1" Classes="secondary" Text="{Binding Line}" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Grid.Row="4" Classes="body2" Margin="0,12,0,0" TextWrapping="Wrap" Text="{Binding BackupStatus}" />
          </Grid>
        </TabItem>

        <TabItem Header="Data">
          <Grid RowDefinitions="Auto,Auto,*,Auto">
            <c:Alert Severity="Warning"
                     Content="Delete everything of one kind. This cannot be taken back; make a backup first. Orders are not listed: they are a mirror of what OKX holds." />
            <Border Grid.Row="1" Classes="tableHead small" Margin="0,12,0,0">
              <Grid ColumnDefinitions="320,*" ColumnSpacing="12" Margin="0,0,8,0">
                <TextBlock Text="Kind of data" />
                <TextBlock Grid.Column="1" Text="Rows" />
              </Grid>
            </Border>
            <ListBox Grid.Row="2" Classes="table small" AutomationProperties.Name="Kinds of data"
                     ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="admin:DataCategory">
                  <Grid ColumnDefinitions="320,*" ColumnSpacing="12">
                    <TextBlock Text="{Binding Label}" />
                    <TextBlock Grid.Column="1" Classes="secondary" Text="{Binding Rows}" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="16" Margin="0,12,0,0">
              <Button Classes="outlined error" Content="Delete everything of the chosen kind…" Command="{Binding AskDeleteCommand}" />
              <TextBlock Classes="body2" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding DataStatus}" />
            </StackPanel>
          </Grid>
        </TabItem>

      </TabControl>
    </c:Card>

    <!--
      The second step of what cannot be taken back. Each lies over the whole page, margins included;
      the first press only opened it.
    -->
    <c:Dialog Grid.RowSpan="2" Margin="-24" Title="Restore a backup"
              IsOpen="{Binding ConfirmingRestore}"
              CloseCommand="{Binding CancelRestoreCommand}"
              Content="When the app next starts, the chosen backup takes the place of the database. Everything newer than the backup is no longer shown. The replaced database is kept in the data folder as trading-agent.db.before-restore.">
      <c:Dialog.Actions>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="No" Command="{Binding CancelRestoreCommand}" />
          <Button Classes="contained" Content="Yes, restore at the next start" Command="{Binding ConfirmRestoreCommand}" />
        </StackPanel>
      </c:Dialog.Actions>
    </c:Dialog>
    <c:Dialog Grid.RowSpan="2" Margin="-24" Title="Delete data"
              IsOpen="{Binding ConfirmingDelete}"
              CloseCommand="{Binding CancelDeleteCommand}"
              Content="Everything of the chosen kind is deleted now and cannot be brought back, except from a backup.">
      <c:Dialog.Actions>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="No" Command="{Binding CancelDeleteCommand}" />
          <Button Classes="contained error" Content="Yes, delete it" Command="{Binding ConfirmDeleteCommand}" />
        </StackPanel>
      </c:Dialog.Actions>
    </c:Dialog>
  </Grid>
</UserControl>
