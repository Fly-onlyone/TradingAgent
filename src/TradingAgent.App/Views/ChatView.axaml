<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TradingAgent.App.ViewModels"
             xmlns:controls="using:TradingAgent.App.Controls"
             x:Class="TradingAgent.App.Views.ChatView"
             x:DataType="vm:ChatViewModel">

  <Grid ColumnDefinitions="260,*">

    <!-- The chats -->
    <Border Grid.Column="0" BorderBrush="{DynamicResource BorderMediumBrush}" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,*" Margin="12">
        <Button Classes="outlined" Grid.Row="0" Content="New chat" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                Command="{Binding NewChatCommand}" />
        <ListBox Grid.Row="1" x:Name="SessionList" Classes="navigation" Margin="0,10,0,0" Background="Transparent"
                 ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:SessionItemViewModel">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="●" Foreground="{DynamicResource PrimaryBrush}" Margin="6,0,0,0"
                           IsVisible="{Binding IsRunning}" ToolTip.Tip="A reply is being written" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>

    <!-- The chosen chat -->
    <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto,Auto" Margin="16,12,16,12">

      <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
        <TextBlock Grid.Column="0" Classes="pageTitle" Text="{Binding Title}" />
        <Button Classes="outlined" Grid.Column="1" Content="Delete chat" Command="{Binding DeleteChatCommand}" />
      </Grid>

      <TextBlock Grid.Row="1" Classes="secondary" HorizontalAlignment="Center" VerticalAlignment="Center"
                 TextWrapping="Wrap" MaxWidth="460" TextAlignment="Center"
                 Text="Ask about a market, your account or a trade. The agent looks things up with its tools and places an order only when you ask for one."
                 IsVisible="{Binding IsEmpty}" />

      <ListBox Grid.Row="1" x:Name="MessageList" Background="Transparent" ItemsSource="{Binding Messages}"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.Styles>
          <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0,5" />
            <Setter Property="Focusable" Value="False" />
          </Style>
          <Style Selector="ListBoxItem:selected /template/ ContentPresenter, ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
          </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:MessageItemViewModel">
            <Border CornerRadius="{DynamicResource RadiusCard}" Padding="14,10"
                    Classes.user="{Binding IsUser}" Classes.assistant="{Binding IsAssistant}">
              <Border.Styles>
                <Style Selector="Border.user">
                  <Setter Property="Background" Value="{DynamicResource BorderMediumBrush}" />
                  <Setter Property="HorizontalAlignment" Value="Right" />
                  <Setter Property="MaxWidth" Value="720" />
                </Style>
                <Style Selector="Border.assistant">
                  <Setter Property="Background" Value="{DynamicResource BackgroundBrush}" />
                  <Setter Property="HorizontalAlignment" Value="Stretch" />
                </Style>
              </Border.Styles>
              <StackPanel Spacing="8">
                <Expander Header="Reasoning" IsVisible="{Binding HasThinking}" HorizontalAlignment="Stretch">
                  <SelectableTextBlock Classes="secondary" TextWrapping="Wrap" Text="{Binding Thinking}" />
                </Expander>
                <ItemsControl ItemsSource="{Binding ToolCalls}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ToolCallItemViewModel">
                      <Border BorderBrush="{DynamicResource BorderMediumBrush}" BorderThickness="1"
                              CornerRadius="{DynamicResource RadiusBase}" Padding="10,6" Margin="0,0,0,4">
                        <StackPanel Spacing="2">
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" FontFamily="Consolas, Cascadia Mono, monospace" FontSize="13"
                                       Text="{Binding Name}" Foreground="{DynamicResource PrimaryBrush}" />
                            <TextBlock Grid.Column="1" Classes="secondary" FontSize="12" Text="{Binding Status}"
                                       Classes.problem="{Binding IsProblem}">
                              <TextBlock.Styles>
                                <Style Selector="TextBlock.problem">
                                  <Setter Property="Foreground" Value="{DynamicResource BearishBrush}" />
                                </Style>
                              </TextBlock.Styles>
                            </TextBlock>
                          </Grid>
                          <SelectableTextBlock Classes="secondary" FontSize="12" TextWrapping="Wrap" Text="{Binding Arguments}" />
                          <SelectableTextBlock FontSize="12" TextWrapping="Wrap" Text="{Binding Summary}"
                                               IsVisible="{Binding Summary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <controls:MarkdownView Text="{Binding Content}" />
                <ProgressBar IsIndeterminate="True" Height="2" IsVisible="{Binding IsRunning}" />
                <TextBlock Foreground="{DynamicResource BearishBrush}" TextWrapping="Wrap" Text="{Binding Note}"
                           IsVisible="{Binding HasNote}" />
                <TextBlock Classes="secondary" FontSize="11" Text="{Binding Footer}"
                           IsVisible="{Binding Footer, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <!-- A question the agent is waiting on -->
      <Border Grid.Row="2" Classes="panel" BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1"
              Padding="14,10" Margin="0,8,0,0" IsVisible="{Binding HasQuestion}">
        <StackPanel Spacing="8">
          <TextBlock Classes="secondary" Text="The agent asks" />
          <TextBlock TextWrapping="Wrap" Text="{Binding Question}" />
          <ItemsControl ItemsSource="{Binding QuestionOptions}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <Button Classes="outlined" Content="{Binding}" Margin="0,0,8,6"
                        Command="{Binding $parent[ItemsControl].((vm:ChatViewModel)DataContext).ChooseOptionCommand}"
                        CommandParameter="{Binding}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Classes="secondary" FontSize="12" Text="Or type your own answer below." />
        </StackPanel>
      </Border>

      <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto" Margin="0,10,0,0">
        <TextBox Classes="small" Grid.Column="0" x:Name="DraftBox" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="160"
                 PlaceholderText="Message the agent. Enter sends, Shift+Enter starts a new line."
                 Text="{Binding Draft}" />
        <Button Grid.Column="1" Content="Send" Margin="8,0,0,0" VerticalAlignment="Bottom" Classes="contained"
                Command="{Binding SendCommand}" />
        <Button Classes="outlined" Grid.Column="2" Content="Stop" Margin="8,0,0,0" VerticalAlignment="Bottom"
                Command="{Binding StopCommand}" />
      </Grid>
    </Grid>
  </Grid>
</UserControl>
