<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TradingAgent.App.ViewModels"
             x:Class="TradingAgent.App.Views.StrategiesView"
             x:DataType="vm:StrategiesViewModel">

  <Grid ColumnDefinitions="320,*">

    <Border Grid.Column="0" BorderBrush="{StaticResource BorderMediumBrush}" BorderThickness="0,0,1,0">
      <ListBox Classes="navigation" Margin="12" Background="Transparent"
               ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:StrategyItemViewModel">
            <StackPanel Spacing="2">
              <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
              <TextBlock Classes="secondary" FontSize="12" Text="{Binding Line}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <ScrollViewer Grid.Column="1">
      <StackPanel Margin="24" Spacing="18" MaxWidth="860" HorizontalAlignment="Left">
        <TextBlock Classes="pageTitle" Text="{Binding Title}" />
        <TextBlock TextWrapping="Wrap" Text="{Binding Message}"
                   IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <!-- The chosen strategy -->
        <StackPanel Spacing="10" IsVisible="{Binding HasSelection}">
          <TextBlock Classes="title" Text="{Binding Selected.Name}" TextWrapping="Wrap" />
          <ToggleSwitch IsChecked="{Binding IsActive}" AutomationProperties.Name="The agent trades by this strategy"
                        OnContent="The agent trades by this strategy" OffContent="Not in use" />
          <SelectableTextBlock TextWrapping="Wrap" Text="{Binding Details}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Classes="secondary" VerticalAlignment="Center" Text="Your rating, 1 to 5" />
            <NumericUpDown Width="130" Minimum="1" Maximum="5" Increment="1" FormatString="0.#" Value="{Binding Rating}"
                           AutomationProperties.Name="Rating" />
          </StackPanel>
          <TextBox Text="{Binding Notes}" PlaceholderText="Notes on how it did for you" AcceptsReturn="True" TextWrapping="Wrap"
                   Height="70" AutomationProperties.Name="Rating notes" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Save rating" Command="{Binding SaveRatingCommand}" />
            <Button Content="Delete strategy" Command="{Binding DeleteCommand}" />
          </StackPanel>
        </StackPanel>

        <!-- Ways to get more -->
        <StackPanel Spacing="8">
          <TextBlock Classes="title" Text="Read a strategy from a page or a text" />
          <TextBlock Classes="secondary" TextWrapping="Wrap"
                     Text="Paste a web address or the text of a strategy. The agent reads it in a conversation of its own and saves it when its rules are clear." />
          <TextBox Text="{Binding ImportText}" AcceptsReturn="True" TextWrapping="Wrap" Height="80"
                   PlaceholderText="https://… or the strategy in words" AutomationProperties.Name="Strategy to import" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Have the agent read it" Command="{Binding ImportCommand}" />
            <Button Content="Look for strategies now" Command="{Binding DiscoverCommand}"
                    ToolTip.Tip="The agent searches the collected news and the web. Discovery on a schedule is switched on in Settings." />
          </StackPanel>
        </StackPanel>

        <StackPanel Spacing="8">
          <TextBlock Classes="title" Text="Write one yourself" />
          <TextBox Text="{Binding NewName}" PlaceholderText="Name" AutomationProperties.Name="New strategy name" />
          <TextBox Text="{Binding NewDescription}" PlaceholderText="What it is and when it works" AcceptsReturn="True"
                   TextWrapping="Wrap" Height="70" AutomationProperties.Name="New strategy description" />
          <TextBox Text="{Binding NewRules}" PlaceholderText="Entry rules, in words or as JSON" AcceptsReturn="True"
                   TextWrapping="Wrap" Height="70" AutomationProperties.Name="New strategy rules" />
          <Button Content="Add strategy" Command="{Binding AddCommand}" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
