<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TradingAgent.App.ViewModels"
             x:Class="TradingAgent.App.Views.OrdersView"
             x:DataType="vm:OrdersViewModel">

  <Grid RowDefinitions="Auto,Auto,*" Margin="24,16">
    <Grid Grid.Row="0" ColumnDefinitions="Auto,180,Auto,*">
      <TextBlock Grid.Column="0" Classes="pageTitle" Text="{Binding Title}" VerticalAlignment="Center" Margin="0,0,16,0" />
      <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding Statuses}" SelectedItem="{Binding Filter}"
                AutomationProperties.Name="Status filter" />
      <Button Grid.Column="2" Content="Ask OKX now" Margin="8,0,0,0" Command="{Binding RefreshCommand}" />
      <TextBlock Grid.Column="3" Classes="secondary" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"
                 Text="{Binding Status}" />
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="150,210,110,140,210,150,*" Margin="12,14,12,4">
      <TextBlock Grid.Column="0" Classes="secondary" FontSize="12" Text="Placed" />
      <TextBlock Grid.Column="1" Classes="secondary" FontSize="12" Text="Instrument" />
      <TextBlock Grid.Column="2" Classes="secondary" FontSize="12" Text="Side" />
      <TextBlock Grid.Column="3" Classes="secondary" FontSize="12" Text="Type" />
      <TextBlock Grid.Column="4" Classes="secondary" FontSize="12" Text="Filled / size" />
      <TextBlock Grid.Column="5" Classes="secondary" FontSize="12" Text="Price" />
      <TextBlock Grid.Column="6" Classes="secondary" FontSize="12" Text="State" />
    </Grid>

    <ListBox Grid.Row="2" Background="Transparent" ItemsSource="{Binding Orders}">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:RowViewModel">
          <Grid ColumnDefinitions="150,210,110,140,210,150,*">
            <TextBlock Grid.Column="0" Classes="secondary" Text="{Binding A}" />
            <TextBlock Grid.Column="1" Text="{Binding B}" />
            <TextBlock Grid.Column="2" Text="{Binding C}" />
            <TextBlock Grid.Column="3" Text="{Binding D}" />
            <TextBlock Grid.Column="4" Text="{Binding E}" />
            <TextBlock Grid.Column="5" Text="{Binding F}" />
            <TextBlock Grid.Column="6" Text="{Binding G}" Classes.good="{Binding IsGood}" Classes.bad="{Binding IsBad}" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</UserControl>
