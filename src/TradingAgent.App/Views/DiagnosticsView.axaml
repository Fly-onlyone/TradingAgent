<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TradingAgent.App.ViewModels"
             x:Class="TradingAgent.App.Views.DiagnosticsView"
             x:DataType="vm:DiagnosticsViewModel">

  <ScrollViewer>
    <StackPanel Margin="24" Spacing="20">

      <TextBlock Classes="pageTitle" Text="{Binding Title}" />

      <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="10">
        <TextBlock Grid.Row="0" Grid.Column="0" Classes="secondary" Text="Version" />
        <SelectableTextBlock Grid.Row="0" Grid.Column="1" Classes="value" Text="{Binding Version}" />

        <TextBlock Grid.Row="1" Grid.Column="0" Classes="secondary" Text="Build" />
        <SelectableTextBlock Grid.Row="1" Grid.Column="1" Classes="value" Text="{Binding Build}" />

        <TextBlock Grid.Row="2" Grid.Column="0" Classes="secondary" Text="Runtime" />
        <SelectableTextBlock Grid.Row="2" Grid.Column="1" Classes="value" Text="{Binding Runtime}" />

        <TextBlock Grid.Row="3" Grid.Column="0" Classes="secondary" Text="Data folder" />
        <SelectableTextBlock Grid.Row="3" Grid.Column="1" Classes="value" Text="{Binding DataFolder}" />

        <TextBlock Grid.Row="4" Grid.Column="0" Classes="secondary" Text="Database" />
        <SelectableTextBlock Grid.Row="4" Grid.Column="1" Classes="value" Text="{Binding DatabaseFile}" />

        <TextBlock Grid.Row="5" Grid.Column="0" Classes="secondary" Text="Schema" />
        <SelectableTextBlock Grid.Row="5" Grid.Column="1" Classes="value" Text="{Binding Schema}" />

        <TextBlock Grid.Row="6" Grid.Column="0" Classes="secondary" Text="Logs" />
        <SelectableTextBlock Grid.Row="6" Grid.Column="1" Classes="value" Text="{Binding LogFolder}" />
      </Grid>

      <StackPanel Spacing="10" IsVisible="{Binding Agent, Converter={x:Static ObjectConverters.IsNotNull}}">
        <TextBlock Classes="title" Text="Agent" />
        <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
          <TextBlock Grid.Row="0" Grid.Column="0" Classes="secondary" Text="Model" />
          <SelectableTextBlock Grid.Row="0" Grid.Column="1" Classes="value" TextWrapping="Wrap" Text="{Binding Agent.Provider}" />

          <TextBlock Grid.Row="1" Grid.Column="0" Classes="secondary" Text="Sign-in" />
          <SelectableTextBlock Grid.Row="1" Grid.Column="1" Classes="value" TextWrapping="Wrap" Text="{Binding Agent.SignIn}" />

          <TextBlock Grid.Row="2" Grid.Column="0" Classes="secondary" Text="OKX trade kit" />
          <SelectableTextBlock Grid.Row="2" Grid.Column="1" Classes="value" TextWrapping="Wrap" Text="{Binding Agent.TradeKit}" />
        </Grid>
        <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{Binding Agent.Notice}"
                   IsVisible="{Binding Agent.Notice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="Run test prompt" Command="{Binding Agent.RunTestPromptCommand}" />
          <Button Content="Stop" Command="{Binding Agent.RunTestPromptCancelCommand}" />
          <Button Content="Check again" Command="{Binding Agent.RefreshCommand}" />
        </StackPanel>
        <TextBlock Classes="secondary" TextWrapping="Wrap" Text="{Binding Agent.TestStatus}" />
        <SelectableTextBlock Classes="value" TextWrapping="Wrap" Text="{Binding Agent.TestEvents}"
                             IsVisible="{Binding Agent.TestEvents, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <SelectableTextBlock Classes="value" TextWrapping="Wrap" Text="{Binding Agent.TestAnswer}"
                             IsVisible="{Binding Agent.TestAnswer, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>

      <StackPanel Spacing="10">
        <TextBlock Classes="title" Text="Desktop shell" />
        <ToggleSwitch IsChecked="{Binding StartWithWindows}"
                      AutomationProperties.Name="Start with Windows"
                      OnContent="Start with Windows" OffContent="Start with Windows" />
        <ToggleSwitch IsChecked="{Binding OpenWindowAtStart}"
                      AutomationProperties.Name="Open the window at start"
                      OnContent="Open the window at start" OffContent="Open the window at start" />
        <Button Content="Send test notification" Command="{Binding SendTestNotificationCommand}" />
        <TextBlock Classes="secondary" Text="{Binding ShellStatus}" />
      </StackPanel>

      <StackPanel Spacing="10">
        <TextBlock Classes="title" Text="Crash reporting" />
        <ToggleSwitch IsChecked="{Binding ReportingEnabled}"
                      AutomationProperties.Name="Send crash and performance reports"
                      OnContent="Send crash and performance reports" OffContent="Send crash and performance reports" />
        <Button Content="Send test error" Command="{Binding SendTestErrorCommand}" />
        <TextBlock Classes="secondary" Text="{Binding ReportingStatus}" />
      </StackPanel>

      <StackPanel Spacing="10">
        <TextBlock Classes="title" Text="Updates" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="Check for updates" Command="{Binding CheckForUpdatesCommand}" />
          <Button Content="Restart to install" Command="{Binding RestartToUpdateCommand}"
                  IsVisible="{Binding IsUpdateReady}" />
        </StackPanel>
        <TextBlock Classes="secondary" Text="{Binding UpdateStatus}" />
      </StackPanel>

    </StackPanel>
  </ScrollViewer>
</UserControl>
