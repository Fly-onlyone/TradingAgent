<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TradingAgent.App.ViewModels"
             x:Class="TradingAgent.App.Views.DiagnosticsView"
             x:DataType="vm:DiagnosticsViewModel">

  <ScrollViewer>
    <StackPanel Margin="24" Spacing="20">

      <TextBlock Classes="pageTitle" Text="{Binding Title}" />

      <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="10">
        <TextBlock Grid.Row="0" Grid.Column="0" Classes="secondary" Text="Version" />
        <SelectableTextBlock Grid.Row="0" Grid.Column="1" Classes="value" Text="{Binding Version}" />

        <TextBlock Grid.Row="1" Grid.Column="0" Classes="secondary" Text="Build" />
        <SelectableTextBlock Grid.Row="1" Grid.Column="1" Classes="value" Text="{Binding Build}" />

        <TextBlock Grid.Row="2" Grid.Column="0" Classes="secondary" Text="Runtime" />
        <SelectableTextBlock Grid.Row="2" Grid.Column="1" Classes="value" Text="{Binding Runtime}" />

        <TextBlock Grid.Row="3" Grid.Column="0" Classes="secondary" Text="Data folder" />
        <SelectableTextBlock Grid.Row="3" Grid.Column="1" Classes="value" Text="{Binding DataFolder}" />

        <TextBlock Grid.Row="4" Grid.Column="0" Classes="secondary" Text="Database" />
        <SelectableTextBlock Grid.Row="4" Grid.Column="1" Classes="value" Text="{Binding DatabaseFile}" />

        <TextBlock Grid.Row="5" Grid.Column="0" Classes="secondary" Text="Schema" />
        <SelectableTextBlock Grid.Row="5" Grid.Column="1" Classes="value" Text="{Binding Schema}" />

        <TextBlock Grid.Row="6" Grid.Column="0" Classes="secondary" Text="Logs" />
        <SelectableTextBlock Grid.Row="6" Grid.Column="1" Classes="value" Text="{Binding LogFolder}" />
      </Grid>

      <StackPanel Spacing="10">
        <TextBlock Classes="title" Text="Desktop shell" />
        <ToggleSwitch IsChecked="{Binding StartWithWindows}"
                      AutomationProperties.Name="Start with Windows"
                      OnContent="Start with Windows" OffContent="Start with Windows" />
        <ToggleSwitch IsChecked="{Binding OpenWindowAtStart}"
                      AutomationProperties.Name="Open the window at start"
                      OnContent="Open the window at start" OffContent="Open the window at start" />
        <Button Content="Send test notification" Command="{Binding SendTestNotificationCommand}" />
        <TextBlock Classes="secondary" Text="{Binding ShellStatus}" />
      </StackPanel>

    </StackPanel>
  </ScrollViewer>
</UserControl>
