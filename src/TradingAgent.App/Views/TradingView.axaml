<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TradingAgent.App.ViewModels"
             xmlns:c="using:TradingAgent.App.Controls"
             xmlns:m="using:TradingAgent.App.Motion"
             x:Class="TradingAgent.App.Views.TradingView"
             x:DataType="vm:TradingViewModel">

  <UserControl.Styles>
    <!-- A small heading inside the card of the market: capitals, widely spaced. -->
    <Style Selector="TextBlock.kicker">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="LetterSpacing" Value="0.96" />
      <Setter Property="LineHeight" Value="19.92" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.kicker.tiny">
      <Setter Property="FontSize" Value="9.6" />
      <Setter Property="LetterSpacing" Value="0.77" />
      <Setter Property="LineHeight" Value="12" />
    </Style>

    <!-- The timeframes: buttons joined in one row, the chosen one lit. -->
    <Style Selector="ListBox.segmented">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.segmented ListBoxItem">
      <Setter Property="Padding" Value="0,4" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
      <Setter Property="BorderThickness" Value="0,1,1,1" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="ListBox.segmented ListBoxItem:nth-child(1)">
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusLeft}" />
    </Style>
    <Style Selector="ListBox.segmented ListBoxItem:nth-last-child(1)">
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusRight}" />
    </Style>
    <Style Selector="ListBox.segmented ListBoxItem:pointerover">
      <Setter Property="Background" Value="#14FFFFFF" />
    </Style>
    <Style Selector="ListBox.segmented ListBoxItem:selected">
      <Setter Property="Background" Value="#29FFFFFF" />
    </Style>
    <Style Selector="ListBox.segmented ListBoxItem:selected:pointerover">
      <Setter Property="Background" Value="#3DFFFFFF" />
    </Style>

    <!-- The small chart under the price is green on a day that is up and red on one that is down. -->
    <Style Selector="c|Sparkline.day">
      <Setter Property="Stroke" Value="#26A69A" />
      <Setter Property="Fill" Value="#4026A69A" />
      <Setter Property="Rising" Value="{DynamicResource BullishColor}" />
      <Setter Property="Falling" Value="{DynamicResource BearishColor}" />
    </Style>
    <Style Selector="c|Sparkline.day.falling">
      <Setter Property="Stroke" Value="#EF5350" />
      <Setter Property="Fill" Value="#40EF5350" />
    </Style>

    <Style Selector="c|RangeBar">
      <Setter Property="LowColor" Value="{DynamicResource BearishColor}" />
      <Setter Property="MiddleColor" Value="{DynamicResource PrimaryColor}" />
      <Setter Property="HighColor" Value="{DynamicResource BullishColor}" />
      <Setter Property="MarkFill" Value="{DynamicResource PaperColor}" />
      <Setter Property="MarkColor" Value="{DynamicResource SuccessColor}" />
    </Style>
    <Style Selector="c|RangeBar.falling">
      <Setter Property="MarkColor" Value="{DynamicResource ErrorColor}" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*">
    <c:SectionHeader Title="Market Monitor" Subtitle="Live market data — the agent uses this data for automated decisions" />

    <Grid Grid.Row="1" ColumnDefinitions="320,*" ColumnSpacing="24">

      <!-- The instrument and its figures -->
      <c:Card m:Enter.Kind="SlideFromLeft">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="20">

            <TextBlock Classes="kicker" Margin="0,0,0,4" Text="SYMBOL" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBox Classes="small" Text="{Binding Symbol}" PlaceholderText="BTC-USDT" AutomationProperties.Name="Instrument" />
              <Button Grid.Column="1" Classes="outlined" Content="Show" IsDefault="True" Command="{Binding LoadCommand}" />
            </Grid>
            <TextBlock Classes="caption bad" Margin="0,6,0,0" TextWrapping="Wrap" Text="{Binding Status}"
                       IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <!-- What is shown: its name, its price, the day's change, the last closes -->
            <Border Margin="0,16,0,0"
                    CornerRadius="{DynamicResource RadiusDouble}"
                    Background="{DynamicResource GradientHeroBrush}"
                    BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                    ClipToBounds="True">
              <StackPanel>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="12">
                  <Border Width="36" Height="36" CornerRadius="18" Background="{DynamicResource GradientPrimaryBrush}">
                    <TextBlock FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Text="{Binding Initial}" />
                  </Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock FontSize="12" FontWeight="Bold" LetterSpacing="0.48" LineHeight="14.4" TextTrimming="CharacterEllipsis"
                               Text="{Binding Shown}" />
                    <TextBlock FontSize="11.2" LineHeight="18.6" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Pair}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock FontFamily="{StaticResource FontMono}" FontSize="20" FontWeight="Bold" LineHeight="22.7"
                               HorizontalAlignment="Right" Text="{Binding Last}" />
                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" IsVisible="{Binding HasTicker}">
                      <TextBlock FontSize="15.2" FontWeight="Bold" LineHeight="18.2" Text="{Binding Change}"
                                 Classes.good="{Binding !IsFalling}" Classes.bad="{Binding IsFalling}" />
                      <TextBlock FontSize="11.2" FontWeight="Medium" VerticalAlignment="Bottom" Margin="0,0,0,1"
                                 Foreground="{DynamicResource TextSecondaryBrush}" Text="24h" />
                    </StackPanel>
                  </StackPanel>
                </Grid>
                <c:Sparkline Classes="day" Classes.falling="{Binding IsFalling}" Height="40" Data="{Binding Closes}"
                             IsVisible="{Binding HasTicker}" />
              </StackPanel>
            </Border>

            <Separator Margin="0,12" />

            <TextBlock Classes="kicker" Margin="0,0,0,4" Text="TIMEFRAME" />
            <ListBox Classes="segmented"
                     AutomationProperties.Name="Timeframe"
                     ItemsSource="{Binding Timeframes}"
                     SelectedItem="{Binding Timeframe}">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
            </ListBox>

            <Separator Margin="0,12" />

            <!-- The day: where the price stands in its range, how much was traded, the spread -->
            <Border CornerRadius="{DynamicResource RadiusCard}"
                    Background="{DynamicResource ActionHoverBrush}"
                    BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                    ClipToBounds="True"
                    IsVisible="{Binding HasTicker}">
              <StackPanel>
                <StackPanel Margin="12">
                  <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                    <TextBlock Classes="kicker" FontSize="10.4" LetterSpacing="0.83" LineHeight="17.3" Text="24H RANGE" />
                    <TextBlock Grid.Column="1" FontFamily="{StaticResource FontMono}" FontSize="11.2" FontWeight="Bold"
                               VerticalAlignment="Center" Text="{Binding RangeText}"
                               Classes.good="{Binding IsHighInRange}" Classes.bad="{Binding !IsHighInRange}" />
                  </Grid>
                  <c:RangeBar Margin="0,0,0,8" Value="{Binding RangePosition}" Classes.falling="{Binding IsFalling}" />
                  <Grid ColumnDefinitions="*,*">
                    <StackPanel>
                      <TextBlock Classes="kicker tiny" FontWeight="Normal" Text="LOW" />
                      <TextBlock FontFamily="{StaticResource FontMono}" FontSize="12" FontWeight="SemiBold" LineHeight="15.6" Text="{Binding Low}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                      <TextBlock Classes="kicker tiny" FontWeight="Normal" HorizontalAlignment="Right" Text="HIGH" />
                      <TextBlock FontFamily="{StaticResource FontMono}" FontSize="12" FontWeight="SemiBold" LineHeight="15.6" Text="{Binding High}" />
                    </StackPanel>
                  </Grid>
                </StackPanel>
                <Separator />
                <Grid ColumnDefinitions="*,Auto,*">
                  <StackPanel Margin="10">
                    <TextBlock Classes="kicker tiny" Margin="0,0,0,2" Text="24H VOLUME" />
                    <TextBlock FontFamily="{StaticResource FontMono}" FontSize="14.4" FontWeight="Bold" LineHeight="17.3"
                               TextTrimming="CharacterEllipsis" Text="{Binding Volume}" />
                  </StackPanel>
                  <Border Grid.Column="1" Width="1" Background="{DynamicResource DividerBrush}" />
                  <StackPanel Grid.Column="2" Margin="10">
                    <TextBlock Classes="kicker tiny" Margin="0,0,0,2" Text="SPREAD" />
                    <TextBlock FontFamily="{StaticResource FontMono}" FontSize="14.4" FontWeight="Bold" LineHeight="17.3"
                               TextTrimming="CharacterEllipsis" Text="{Binding Spread}" />
                    <TextBlock FontFamily="{StaticResource FontMono}" FontSize="10.4" Margin="0,4,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding SpreadPercent}" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>

            <Separator Margin="0,12" IsVisible="{Binding HasTicker}" />

            <!-- The indicators the agent and the risk check read -->
            <TextBlock Classes="kicker" Margin="0,0,0,8" Text="INDICATORS" IsVisible="{Binding HasTicker}" />
            <ItemsControl ItemsSource="{Binding IndicatorRows}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="4" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:FigureRow">
                  <Border Padding="8,6" CornerRadius="{DynamicResource RadiusBase}" Background="{DynamicResource ActionHoverBrush}">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Classes="body2 medium" Text="{Binding Label}" />
                      <TextBlock Grid.Column="1" Classes="caption semibold mono" VerticalAlignment="Center" Text="{Binding Value}"
                                 Classes.good="{Binding IsGood}" Classes.bad="{Binding IsBad}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Classes="caption secondary" Margin="0,8,0,0" TextWrapping="Wrap"
                       Text="Not enough price history for the indicators."
                       IsVisible="{Binding LacksIndicators}" />
          </StackPanel>
        </ScrollViewer>
      </c:Card>

      <!-- The price chart -->
      <c:Card Grid.Column="1" m:Enter.Kind="Reveal" m:Enter.Delay="0.1">
        <DockPanel Margin="16">
          <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8" Margin="0,0,0,12">
            <TextBlock Classes="h6" VerticalAlignment="Center" Text="{Binding Shown}" />
            <c:Chip Grid.Column="1" Classes="outlined small" VerticalAlignment="Center" Content="{Binding Timeframe}" />
            <SelectableTextBlock Grid.Column="2" Classes="caption secondary" HorizontalAlignment="Right" VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis" Text="{Binding Day}" />
          </Grid>
          <TextBlock DockPanel.Dock="Bottom" Classes="caption secondary" Margin="0,8,0,0" TextWrapping="Wrap"
                     Text="Wheel zooms, drag moves. The line is the 20-bar average. To trade, ask the agent in Chat: every order goes through the risk check." />
          <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="{DynamicResource RadiusBase}" ClipToBounds="True">
            <c:CandleChart Candles="{Binding Candles}" />
          </Border>
        </DockPanel>
      </c:Card>
    </Grid>
  </Grid>
</UserControl>
