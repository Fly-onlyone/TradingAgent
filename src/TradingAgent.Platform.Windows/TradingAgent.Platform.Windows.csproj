  <PropertyGroup>
    <!-- The Windows 10 2004 target brings the WinRT projection used for toast notifications. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <!-- Required by the source generators for COM interfaces and P/Invoke. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TradingAgent.Core\TradingAgent.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
  </ItemGroup>

</Project>
