# ── Application ──────────────────────────────────────────────────
DEBUG=false
# REQUIRED in production — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
# Set to false to prevent auth bypass even in debug mode
# ALLOW_DEBUG_AUTH_BYPASS=true

# ── CORS ────────────────────────────────────────────────────────
# Comma-separated origins. If empty: dev defaults in debug, deny-all in production.
# CORS_ORIGINS=https://app.example.com,https://admin.example.com

# ── MongoDB ─────────────────────────────────────────────────────
# Use authenticated URI in production: mongodb://user:password@host:port
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=trading_agent

# ── OKX Exchange ────────────────────────────────────────────────
# Prefer storing these via the Settings UI (encrypted in DB).
# Env vars are used as fallback.
# OKX_API_KEY=
# OKX_SECRET_KEY=
# OKX_PASSPHRASE=
# OKX_SANDBOX=true

# ── Claude AI (Agent) ──────────────────────────────────────────
# If empty, the Agent SDK uses Claude Code CLI credentials (requires `claude login`).
# ANTHROPIC_API_KEY=

# ── Secret Encryption ──────────────────────────────────────────
# Comma-separated Fernet keys (first key encrypts, all decrypt for rotation).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# SECRETS_ENCRYPTION_KEYS=

# ── OpenAI (embeddings) ────────────────────────────────────────
# Env-var-only — not stored in DB encryption.
# OPENAI_API_KEY=

# ── External Data APIs (env-var-only) ──────────────────────────
# GLASSNODE_API_KEY=
# COINGECKO_API_KEY=
# DEFILLAMA_API_URL=https://api.llama.fi

# ── Sentry ──────────────────────────────────────────────────────
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=trading-agent-backend@0.1.0
# SENTRY_TRACES_SAMPLE_RATE=0.1
# Set to false to disable Sentry Logs ingestion from Python logging records.
# SENTRY_ENABLE_LOGS=true

# ── Notifications (Apprise) ────────────────────────────────────────
# Comma-separated Apprise URLs for broadcast notifications (trade alerts, etc.)
# Examples: tgram://bottoken/chatid, discord://webhook_id/webhook_token, mailto://user:pass@smtp.gmail.com
# See https://github.com/caronc/apprise/wiki for all supported services
# Leave empty to log notifications to console (dev mode)
# NOTIFICATION_URLS=

# Email-specific URL for transactional emails (password reset, verification)
# Must be a mailto:// URL. Leave empty to log to console.
# Example: mailto://user:pass@smtp.gmail.com
# EMAIL_URL=

# ── Frontend URL ───────────────────────────────────────────────────────
# Used in notification links for password-reset and verification.
# FRONTEND_URL=http://localhost:3000

# ── Logging ─────────────────────────────────────────────────────────
# LOG_LEVEL=INFO
# LOG_DIR=logs
# LOG_MAX_BYTES=10485760
# LOG_BACKUP_COUNT=5
