# Sentry frontend configuration
# SENTRY_AUTH_TOKEN=          # Required for source map uploads during build
# VITE_SENTRY_DSN=
# VITE_SENTRY_ENVIRONMENT=development
# VITE_SENTRY_RELEASE=trading-agent-frontend@0.1.0
# Must be between 0 and 1.
# VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
# Optional comma-separated URL or path matchers for trace header propagation.
# Example: https://api.example.com/v1,/internal-api
# VITE_SENTRY_TRACE_PROPAGATION_TARGETS=
# Set to false to disable Sentry Logs ingestion from the browser.
# VITE_SENTRY_ENABLE_LOGS=true
