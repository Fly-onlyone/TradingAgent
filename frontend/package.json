  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@sentry/vite-plugin": "^11.10.0",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
