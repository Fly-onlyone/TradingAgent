  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@sentry/vite-plugin": "^5.3.0",
    "@tauri-apps/cli": "^2",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^9.2.1",
