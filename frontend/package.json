  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@sentry/vite-plugin": "^5.4.0",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
