    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0"
  },
  "name": "frontend",
  "private": true,
  "scripts": {
    "build": "vite build && tsc",
    "build:all": "concurrently -n vite,sidecar -c blue,green \"bun run build\" \"bun run build:backend-sidecar\"",
    "build:backend-sidecar": "node scripts/build-backend-sidecar.mjs",
    "build:backend-sidecar-force": "node scripts/build-backend-sidecar.mjs --force",
    "check": "biome check",
    "dev": "vite --port 3000",
    "dev:all": "concurrently --kill-others -n front,back -c blue,green \"bun run dev\" \"bun run dev:backend\"",
    "dev:backend": "cd .. && uv run python run.py --serve",
    "dev:tauri-managed": "node scripts/tauri-dev.mjs",
    "format": "biome format",
    "lint": "biome lint",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:build": "tauri build",
    "tauri:dev": "tauri dev",
    "test": "vitest run"
  },
  "type": "module",
  "version": "0.1.2"
}
