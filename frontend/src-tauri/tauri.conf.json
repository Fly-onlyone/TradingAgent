{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "app": {
    "security": {
      "csp": {
        "connect-src": "http://localhost:* ws://localhost:* http://127.0.0.1:* ws://127.0.0.1:* ipc: http://ipc.localhost https://*.ingest.sentry.io https://*.ingest.us.sentry.io",
        "default-src": "'self' customprotocol: asset: http://asset.localhost",
        "font-src": "'self' data:",
        "img-src": "'self' asset: http://asset.localhost data: blob: https://assets.coincap.io",
        "script-src": "'self' 'unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'"
      },
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    },
    "windows": [
      {
        "center": true,
        "decorations": true,
        "fullscreen": false,
        "height": 900,
        "label": "main",
        "minHeight": 700,
        "minWidth": 1024,
        "resizable": true,
        "title": "Trading agent",
        "visible": false,
        "width": 1400
      }
    ]
  },
  "build": {
    "beforeBuildCommand": "bun run build:all",
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Fly",
    "resources": [
      "trading-agent-backend.exe",
      ".env",
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png"
    ],
    "targets": "all",
    "windows": {
      "nsis": {},
      "wix": {}
    }
  },
  "identifier": "com.fly.tradingagent",
  "plugins": {
    "shell": {
      "open": true
    }
  },
  "productName": "Trading agent",
  "version": "0.1.2"
}
