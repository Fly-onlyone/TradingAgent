{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Trading agent",
  "version": "0.1.0",
  "identifier": "com.fly.tradingagent",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "title": "Trading agent",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true,
        "decorations": true,
        "resizable": true,
        "fullscreen": false,
        "label": "main"
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval'; connect-src http://localhost:7000 ws://localhost:7000 http://localhost:7001 ws://localhost:7001 http://localhost:3000 ws://localhost:3000 ipc: http://ipc.localhost; img-src 'self' data: blob:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {}
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
